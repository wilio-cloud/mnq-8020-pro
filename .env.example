# ==============================================================================
# 1. NOTIFICACIONS DISCORD (ESSENCIAL PER A ALERTES MACRO A RAILWAY)
# ==============================================================================
# URL del Webhook del canal de Discord on s'enviarà l'alerta macro diària
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/TEU_WEBHOOK_ID/TEU_WEBHOOK_TOKEN

# Notificacions opcionals per a Telegram (deixar buit si no s'utilitza)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# 2. CONFIGURACIÓ GENERAL DEL SERVEI
# ==============================================================================
# Mode del bot: 
# - "macro_only": Només alertes de calendari macro a Discord (recomanat per a alertes sense broker)
# - "funded": Operativa completa conservadora (briefing macro + execució a broker)
# - "evaluation": Fast-pass d'alta intensitat per a avaluacions de prop firm
BOT_MODE=funded

# Símbol base de futurs del CME Globex
SYMBOL_BASE=MNQ

# Zona horària de referència del mercat de Chicago/Nova York
TIMEZONE=America/New_York

# ==============================================================================
# 3. PARÀMETRES ESTRATÈGIA 80/20 NY OPEN (15:30 CEST · MÀX 1 TRADE)
# ==============================================================================
# Take Profit (punts d'índex): 12 pts = 48 ticks ($24 per 1 MNQ)
TP_POINTS=12.0

# Stop Loss (punts d'índex): 50 pts = 200 ticks ($100 per 1 MNQ)
SL_POINTS=50.0

# Límit màxim de trades per sessió
MAX_DAILY_TRADES=1

INITIAL_CONTRACTS=1
AUTO_SCALE=false

# ==============================================================================
# 4. CREDENCIALS TRADOVATE (OPCIONAL SI ES FA SERVIR 'macro_only')
# ==============================================================================
# Entorn: "demo" (simulació) o "live" (compte real / PA funded)
TRADOVATE_ENV=demo

# Credencials d'accés
TRADOVATE_USER=el_teu_usuari
TRADOVATE_PASS=la_teva_contrasenya

# Credencials d'API (obtingudes a Tradovate -> Settings -> Add-ons / API Access)
TRADOVATE_APP_ID=MNQZonesBot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=el_teu_api_secret

# Compte específic (opcional, si es deixa buit agafa el compte per defecte)
TRADOVATE_ACCOUNT_ID=
TRADOVATE_ACCOUNT_SPEC=

# ==============================================================================
# 5. HISTORICAL DATA (DATABENTO - OPCIONAL PER A RE-BACKTESTING)
# ==============================================================================
DATABENTO_API_KEY=

